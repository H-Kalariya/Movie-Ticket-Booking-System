# Copy to .env and adjust. Never commit the real .env.
PORT=4000
NODE_ENV=development

# MongoDB connection string. For local dev: mongodb://127.0.0.1:27017/curtaincall
# For Atlas: mongodb+srv://<user>:<pass>@<cluster>/curtaincall?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/curtaincall

# Secrets for signing JWTs. Use long random strings in production.
JWT_ACCESS_SECRET=change-me-access-secret-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated list of allowed browser origins (the Vite dev server, your prod domain, etc.)
CORS_ORIGIN=http://localhost:5173

# Seed credentials (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@cinema.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_OWNER_EMAIL=owner@cinema.com
SEED_OWNER_PASSWORD=Owner@123
